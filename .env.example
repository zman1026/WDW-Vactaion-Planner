# Copy this file to .env and fill in the values

# PostgreSQL connection string (Railway provides this automatically in production)
DATABASE_URL="postgresql://user:password@host:5432/railway?schema=public"

# Auth.js / GitHub OAuth (callback: /api/auth/callback/github)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GITHUB_ID=""
GITHUB_SECRET=""

# Optional one-time migration: transfer trips from the former local user on login
# MIGRATE_LOCAL_TRIPS_TO_EMAIL="you@example.com"

# AI itinerary suggestions (OpenAI is preferred when both are set)
# XAI_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL="gpt-5.6-luna"
