# Copy this file to .env and fill in the values

# Local PostgreSQL connection string. Do not paste this example into Railway.
# In the Railway web service, use the PostgreSQL reference variable instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wdw_planner?schema=public"

# Auth.js email/password sessions
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional Google sign-in. Configure this callback URL in Google Cloud:
# http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional one-time migration: transfer trips from the former local user on login
# MIGRATE_LOCAL_TRIPS_TO_EMAIL="you@example.com"

# Optional bearer token for Railway cron calls to POST /api/entities/sync
# CRON_SECRET=
